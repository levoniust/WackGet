// WackGet resources (Windows): the program icon, version information and the manifest that wx.rc
// adds (common controls 6, per-monitor-v2 DPI awareness).
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2

// "aaaa" sorts first, so Explorer uses it as the program icon
aaaa ICON "../../WackGet/res/wackget.ico"

#include "wx/msw/wx.rc"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "WackGet contributors"
      VALUE "FileDescription", "WackGet download manager"
      VALUE "FileVersion", "2.0.0-dev"
      VALUE "InternalName", "WackGet"
      VALUE "LegalCopyright", "Copyright (C) 2002-2003 Millweed; GNU GPL v2"
      VALUE "OriginalFilename", "WackGet.exe"
      VALUE "ProductName", "WackGet"
      VALUE "ProductVersion", "2.0.0-dev"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
